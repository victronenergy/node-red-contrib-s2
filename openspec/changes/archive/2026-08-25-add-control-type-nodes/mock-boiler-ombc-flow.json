        "func": "// msg.payload is the boiler's current wattage (L2 only).\nconst watts = msg.payload\n\nmsg.payload = {\n    command: 'PowerMeasurement',\n    cemId: 'cem',\n    values: [\n        { commodity_quantity: 'ELECTRIC.POWER.L1', value: 0 },\n        { commodity_quantity: 'ELECTRIC.POWER.L2', value: watts },\n        { commodity_quantity: 'ELECTRIC.POWER.L3', value: 0 }\n    ]\n}\n\nreturn msg\n",
