    {
        "id": "f7a1c2d3e4b5000a",
        "type": "function",
        "z": "f7a1c2d3e4b50001",
        "name": "Buffer simulator",
        "func": "// Simulates the buffer tank: integrates the instructed fill rate minus leakage, reports the\n// fill level every tick, and confirms each instruction straight away (a real flow would confirm\n// once the heat pump actually switched).\nconst LEAKAGE_PER_S = 0.002 // % per second - matches the leakage in the FRBC config\nconst now = Date.now()\nconst last = context.get('last') ?? now\nconst rate = context.get('rate') ?? 0\nlet fill = context.get('fill') ?? 50\nfill = Math.min(100, Math.max(0, fill + (rate - LEAKAGE_PER_S) * (now - last) / 1000))\ncontext.set('fill', fill)\ncontext.set('last', now)\n\nif (msg.topic === 'ActuatorInstruction') {\n    context.set('rate', msg.payload.fillRate)\n    node.status({ fill: 'blue', shape: 'dot', text: `${msg.payload.operationModeLabel} - ${fill.toFixed(1)} %` })\n    return [{ topic: 'ActuatorConfirmation', payload: msg.payload, cemId: msg.cemId }, null]\n}\nif (msg.topic === 'Selected' || msg.topic === 'Deselected') {\n    return [null, null]\n}\nnode.status({ fill: 'grey', shape: 'ring', text: `${fill.toFixed(1)} %` })\nreturn [null, { topic: 'StorageStatus', payload: { fillLevel: Math.round(fill * 10) / 10 } }]\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
