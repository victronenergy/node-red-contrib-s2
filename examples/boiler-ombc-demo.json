    {
        "id": "b1a2c3d4e5f60012",
        "type": "function",
        "z": "b1a2c3d4e5f60001",
        "name": "Generate and send Power Report",
        "func": "// msg.payload is the boiler's current wattage (L2 only - see the OMBC\n// system description on the 'RM - Boiler' node).\nconst watts = msg.payload\n\nmsg.payload = {\n    command: 'PowerMeasurement',\n    cemId: 'cem',\n    values: [\n        { commodity_quantity: 'ELECTRIC.POWER.L1', value: 0 },\n        { commodity_quantity: 'ELECTRIC.POWER.L2', value: watts },\n        { commodity_quantity: 'ELECTRIC.POWER.L3', value: 0 }\n    ]\n}\n\nreturn msg\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 460,
        "wires": [
            [
                "b1a2c3d4e5f60006",
                "b1a2c3d4e5f60013"
            ]
        ]
    },
