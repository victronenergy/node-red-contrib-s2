    {
        "id": "b32dad59271ab90f",
        "type": "comment",
        "z": "89462d0157a97648",
        "d": true,
        "g": "2550bfa94693154d",
        "name": "Notes on handling ModeRequest",
        "info": "The ModeRequest is sent when the CEM has selected OMBC but no active operation mode is known yet. Here, this never happens because the Venus Relay state always sets the correct mode when the flow gets deployed.\n\nIf your integration does not automatically provide a status on flow deployment, either:\n\n 1. Use a inject node which fires on deployment to set a default operation mode\n 2. Or better, use the ModeRequest as the trigger to provide the latest operation mode of your device",
        "x": 190,
        "y": 700,
        "wires": []
    },
