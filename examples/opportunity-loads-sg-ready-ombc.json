    {
        "id": "c4456b97faeec6b4",
        "type": "function",
        "z": "89462d0157a97648",
        "g": "2550bfa94693154d",
        "name": "Fake PowerMeasurement",
        "func": "// Get the S2-shaped commodity power values (one {commodity_quantity, value}\n// pair per phase, L1-L3) expected by the currently active operation mode\nlet powerValues = flow.get(\"powerValues\");\n\n// If power values not yet set, do nothing\nif (powerValues === undefined) return null;\n\nconst s2 = {\n    topic: \"PowerMeasurement\",\n    payload: {\n        values: powerValues\n    }\n}\n\nconst voltage = 230;\nconst power = powerValues[0].value // L1 power\nconst victron = {\n    payload: {\n        \"/Ac/Power\": power,\n        \"/Ac/L1/Power\": power,\n        \"/Ac/L1/Voltage\": voltage,\n        \"/Ac/L1/Current\": power / voltage,\n        \"/Ac/L1/PowerFactor\": 1\n    }\n};\n\nnode.status({\n    shape: \"dot\",\n    fill: \"blue\",\n    text: \"Faked power: \" + JSON.stringify(powerValues).replaceAll(\",\", \", \")\n})\n\nreturn [s2, victron]",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 620,
        "wires": [
            [
                "5af763f979d3e51f"
            ],
